    <command id="command1" type="Text">
      <text><![CDATA[
select
	"tbl_dwgGen_RequestQueue"."requestID" "RequestID"
	,"tbl_dwgGen_RequestQueue"."requesterUserName" "RequesterUserName"
	,"tbl_dwgGen_RequestQueue"."requesterCompany" "RequesterCompany"
	,"tbl_dwgGen_RequestQueue"."requesterEmail" "RequesterEmail"
	,"tbl_dwgGen_RequestQueue"."SalesRepName" "SalesRepName"
	,"tbl_dwgGen_RequestQueue"."SalesRepCompany" "SalesRepCompany"
	,"tbl_dwgGen_RequestQueue"."SalesRepEmail" "SalesRepEmail"
	,"tbl_dwgGen_RequestQueue"."DrawingFormat" "DrawingFormat"
	,"tbl_dwgGen_RequestQueue"."masterJSON" "MasterJson"
	,"tbl_dwgGen_RequestQueue"."statusID" "StatusID"
	,"tbl_dwgGen_RequestQueue"."fileNameBase" "FileNameBase"
	,"tbl_dwgGen_RequestQueue"."jobRequestType" "JobRequestType"
	,"tbl_dwgGen_RequestQueue"."salesOrderNumber" "SalesOrderNumber"
	,"tbl_dwgGen_RequestQueue"."quoteNumber" "QuoteNumber"
	,"tbl_dwgGen_RequestQueue"."projectName" "ProjectName"
	,"tbl_dwgGen_RequestQueue"."customerName" "CustomerName"
	,"tbl_dwgGen_RequestQueue"."dateAddedToQueue" "DateAddedToQueue"
	,"tbl_dwgGen_RequestQueue"."DWGGenServerName" "DwggenServerName"
	,"tbl_dwgGen_RequestQueue"."dateDWGGenStarted" "DateDwggenStarted"
	,"tbl_dwgGen_RequestQueue"."dateDWGGenAllCompleted" "DateDwggenAllCompleted"
	,"tbl_dwgGen_RequestQueue"."dateSAPFirstFileReceived" "DateSapfirstFileReceived"
	,"tbl_dwgGen_RequestQueue"."dateSAPFileAllCompleted" "DateSapfileAllCompleted"
	,"tbl_dwgGen_RequestQueue"."dateEmailSent" "DateEmailSent"
	,"tbl_dwgGen_RequestQueue"."dateDWGGenFailed" "DateDwggenFailed"
	,"tbl_dwgGen_RequestQueue"."SourceID" "SourceID"
	,"tbl_dwgGen_RequestQueue"."dateTactonUploadStarted" "DateTactonUploadStarted"
	,"tbl_dwgGen_RequestQueue"."dateTactonUploadCompleted" "DateTactonUploadCompleted"
	,"tbl_dwgGen_RequestQueue"."dateTactonUploadFailed" "DateTactonUploadFailed"
	,"tbl_dwgGen_RequestQueue"."tactonConfiguredProductId" "TactonConfiguredProductID"
	,"tbl_dwgGen_RequestQueue"."tactonConfiguredProductStrong" "TactonConfiguredProductStrong"
	,"tbl_dwgGen_RequestQueue"."tactonSolutionId" "TactonSolutionID"
	,"tbl_dwgGen_RequestQueue"."tactonDrawingId" "TactonDrawingID"
	,"tbl_dwgGen_RequestQueue"."tactonWorkflowStateID" "TactonWorkflowStateID"
	,"tbl_dwgGen_RequestQueue"."tactonTransitionStatus" "TactonTransitionStatus"
	,"tbl_dwgGen_RequestQueue"."tactonTicketNo" "TactonTicketNo"
	,CASE
		WHEN "tbl_dwgGen_RequestQueue"."dateDWGGenFailed" IS NOT NULL THEN 'Failed'
		WHEN "tbl_dwgGen_RequestQueue"."dateEmailSent" IS NOT NULL THEN 'Completed'
		ELSE 'Processing'
	 END "StatusText"
	,CASE
		WHEN "tbl_dwgGen_RequestQueue"."dateEmailSent" IS NOT NULL THEN 'DWG Download Email'
		WHEN "tbl_dwgGen_RequestQueue"."dateSAPFileAllCompleted" IS NOT NULL THEN 'File Transfer'
		WHEN "tbl_dwgGen_RequestQueue"."dateSAPFirstFileReceived" IS NOT NULL THEN 'SAP'
		WHEN "tbl_dwgGen_RequestQueue"."dateDWGGenStarted" IS NOT NULL THEN 'AutoCAD Processing'
		WHEN "tbl_dwgGen_RequestQueue"."dateTactonUploadStarted" IS NOT NULL
			OR "tbl_dwgGen_RequestQueue"."dateTactonUploadCompleted" IS NOT NULL THEN 'Caller'
		ELSE 'Request Submitted'
	 END "SubStatusText"
from "dbo"."tbl_dwgGen_RequestQueue" "tbl_dwgGen_RequestQueue"
]]></text>
    </command>
